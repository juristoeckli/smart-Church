POSTGRES_USER=smart_church_dev
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=smart_church_dev
DATABASE_URL=postgresql://smart_church_dev:change-this-local-password@127.0.0.1:5432/smart_church_dev
SMART_CHURCH_DEPARTMENT_ID=00000000-0000-4000-8000-000000000001
SMART_CHURCH_DEPARTMENT_NAME=Location not configured
# Optional email delivery via Resend; keep the API key private.
# SMART_CHURCH_RESEND_API_KEY=re_...
# SMART_CHURCH_EMAIL_FROM=Smart Church <notifications@your-verified-domain.org>
# SMART_CHURCH_RESEND_WEBHOOK_SECRET=whsec_...
# Optional dedicated key for encrypting the SMTP password saved in Server > Email settings.
# If omitted, the database URL is used as the encryption key source.
# SMART_CHURCH_EMAIL_ENCRYPTION_KEY=<generate a long random secret>
# Legacy EventDesk aliases are also accepted by the API.
# RESEND_API_KEY=re_...
# EVENTDESK_EMAIL_FROM=Church Rentals <rentals@example.org>
# The API stays on loopback for local development. Set HOST=0.0.0.0 only
# inside its private container network when running behind a reverse proxy.
HOST=127.0.0.1
# Optional; defaults to this private, persistent application-data path in Docker.
# SMART_CHURCH_SYNC_IDENTITY_KEY_FILE=/var/lib/smart-church/sync/identity-ed25519.pem
# Automatic full-site standby replication interval (seconds, bounded to 30–240; defaults to 60).
SMART_CHURCH_REDUNDANCY_SYNC_INTERVAL_SECONDS=60
# Optional; keep the actual configuration file outside the repository.
# STREAMING_CONFIG_FILE=C:/path/to/smart-Church/apps/api/src/modules/video-steffisburg/streaming.steffisburg.json
# STREAMING_STATE_DIR=C:/path/to/private/video-state
# PYTHON_BINARY=C:/path/to/python.exe
# Remote desktop uses the optional Guacamole profile in
# apps/api/src/modules/remote-desktop/compose.yaml. Keep secrets in .env only.
# SYSTEM_LAPTOP_JSON_SECRET_KEY=<generate 32 hex characters with Node crypto>
# Legacy destination values are imported into the encrypted module store once.
# SYSTEM_LAPTOP_RDP_HOST=<private-rdp-host>
# SYSTEM_LAPTOP_RDP_PORT=3389
# SYSTEM_LAPTOP_RDP_USERNAME=smart-church-control
# SYSTEM_LAPTOP_RDP_PASSWORD=<private-password>
# SYSTEM_LAPTOP_GUACAMOLE_API_URL=http://127.0.0.1:8080/guacamole
