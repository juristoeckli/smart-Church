# Copy this file to .env on the Smart-Church host and replace every example value.
# The database password in this URL must be URL-encoded if it contains reserved characters.
POSTGRES_USER=smart_church
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=smart_church
SMART_CHURCH_DATABASE_URL=postgresql://smart_church:replace-with-a-long-random-password@db:5432/smart_church
SMART_CHURCH_WEB_ORIGIN=https://church.example.org
SMART_CHURCH_DOMAIN=church.example.org

# For the bundled Caddy profile, trust its fixed address below.
# With an external reverse proxy, replace this with that proxy's source address or CIDR.
SMART_CHURCH_TRUST_PROXY=172.30.250.2
SMART_CHURCH_DOCKER_SUBNET=172.30.250.0/24
SMART_CHURCH_PROXY_IP=172.30.250.2
SMART_CHURCH_VERSION=latest

SMART_CHURCH_DEPARTMENT_ID=00000000-0000-4000-8000-000000000001
SMART_CHURCH_DEPARTMENT_NAME=Church location
SMART_CHURCH_SYNC_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# Optional Video & streaming module for the Steffisburg deployment. Add the
# module Compose file when starting the stack; keep config beside its module.
# SMART_CHURCH_STREAMING_CONFIG_PATH=./apps/api/src/modules/video-steffisburg/streaming.steffisburg.json

# Optional System Laptop module. Use the profile only after setting these values.
# SYSTEM_LAPTOP_JSON_SECRET_KEY=<32 hexadecimal characters>
# SYSTEM_LAPTOP_RDP_HOST=<private-rdp-host>
# SYSTEM_LAPTOP_RDP_PORT=3389
# SYSTEM_LAPTOP_RDP_USERNAME=smart-church-control
# SYSTEM_LAPTOP_RDP_PASSWORD=<private-password>

# Optional DS-700 discovery for Video & Streaming > Converter Setup.
# BMD_CONVERTER_DS700_HOST=<DS-700-address>
# BMD_CONVERTER_DS700_PORT=19540
# Optional override for the local NIC identity used by the DS-700 attach handshake.
# BMD_CONVERTER_CLIENT_MAC=00:11:22:33:44:55

# Central proxy on the same host can use the loopback-bound upstream ports.
# For a central proxy on another host, bind these to a private interface and restrict
# access with the host firewall to the reverse proxy's source address.
SMART_CHURCH_API_BIND_ADDRESS=127.0.0.1
SMART_CHURCH_API_HOST_PORT=3001
SMART_CHURCH_WEB_BIND_ADDRESS=127.0.0.1
SMART_CHURCH_WEB_HOST_PORT=8080

# Used only with --profile bundled-proxy. Caddy requests and renews certificates automatically.
SMART_CHURCH_HTTPS_BIND_ADDRESS=0.0.0.0
SMART_CHURCH_HTTP_PORT=80
SMART_CHURCH_HTTPS_PORT=443
