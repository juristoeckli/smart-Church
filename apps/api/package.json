{
  "name": "@smart-church/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:datasets": "node --experimental-strip-types scripts/test-datasets.mjs",
    "test:email-worker": "node --import tsx scripts/test-email-worker.mjs",
    "test:runtime-diagnostics": "node --import tsx scripts/test-runtime-diagnostics.mjs",
    "test:server-permissions": "node --experimental-strip-types scripts/test-server-permissions.mjs",
    "test:notification-email-template": "node --experimental-strip-types scripts/test-notification-email-template.mjs",
    "test:converter": "node --env-file-if-exists=../../.env src/modules/video-steffisburg/scripts/test-bmd-converter.mjs"
  },
  "dependencies": {
    "@smart-church/contracts": "workspace:*",
    "fastify": "^5.12.5",
    "ffmpeg-static": "5.3.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.0"
  }
}
