# Activate the Steffisburg Video module using its included site configuration.
SMART_CHURCH_STREAMING_CONFIG_PATH=./apps/api/src/modules/video-steffisburg/streaming.steffisburg.json

# Keep the UniFi API key private in the deployment .env. Never place it in JSON.
SMART_CHURCH_VIDEO_STEFFISBURG_UNIFI_API_KEY=

# Optional YouTube Live integration. Configure the client ID, secret, and redirect URI
# in Settings > Modules > Video & streaming, then register that URI in Google Cloud.
# The API generates and persists its own encryption key in its protected data volume.
# Optional compatibility fallback; normally set the redirect URI in module settings.
SMART_CHURCH_VIDEO_STEFFISBURG_YOUTUBE_REDIRECT_URI=

# Optional DS-700 discovery settings for Video & Streaming > Converter Setup.
SMART_CHURCH_VIDEO_STEFFISBURG_DS700_HOST=10.6.70.90
SMART_CHURCH_VIDEO_STEFFISBURG_DS700_PORT=19540
SMART_CHURCH_VIDEO_STEFFISBURG_CLIENT_MAC=9c:5c:8e:00:c7:ac
